{
  "version": "1.0",
  "name": "BlogAPI",
  "imports": [
    "@typespec/http",
    "@omnidotdev/typespec-drizzle"
  ],
  "models": {
    "User": {
      "description": "A blog user account",
      "decorators": ["@table"],
      "fields": {
        "id": {
          "type": "string",
          "format": "uuid",
          "decorators": ["@id"],
          "description": "Unique user identifier"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "username": {
          "type": "string",
          "constraints": {
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "description": "Unique username"
        },
        "displayName": {
          "type": "string",
          "optional": true,
          "constraints": {
            "maxLength": 100
          },
          "description": "Display name shown on posts"
        },
        "role": {
          "type": "UserRole",
          "description": "User's permission level"
        },
        "createdAt": {
          "type": "utcDateTime",
          "decorators": ["@createdAt"]
        },
        "updatedAt": {
          "type": "utcDateTime",
          "decorators": ["@updatedAt"]
        }
      }
    },
    "Post": {
      "description": "A blog post",
      "decorators": ["@table"],
      "fields": {
        "id": {
          "type": "string",
          "format": "uuid",
          "decorators": ["@id"]
        },
        "title": {
          "type": "string",
          "constraints": {
            "minLength": 1,
            "maxLength": 200
          },
          "description": "Post title"
        },
        "slug": {
          "type": "string",
          "constraints": {
            "pattern": "^[a-z0-9-]+$"
          },
          "description": "URL-friendly slug"
        },
        "content": {
          "type": "string",
          "description": "Post content in Markdown"
        },
        "excerpt": {
          "type": "string",
          "optional": true,
          "constraints": {
            "maxLength": 500
          },
          "description": "Short excerpt for previews"
        },
        "authorId": {
          "type": "string",
          "format": "uuid",
          "decorators": ["@manyToOne(User)"]
        },
        "status": {
          "type": "PostStatus"
        },
        "publishedAt": {
          "type": "utcDateTime",
          "optional": true
        },
        "createdAt": {
          "type": "utcDateTime",
          "decorators": ["@createdAt"]
        },
        "updatedAt": {
          "type": "utcDateTime",
          "decorators": ["@updatedAt"]
        }
      }
    },
    "Comment": {
      "description": "A comment on a post",
      "decorators": ["@table"],
      "fields": {
        "id": {
          "type": "string",
          "format": "uuid",
          "decorators": ["@id"]
        },
        "content": {
          "type": "string",
          "constraints": {
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "postId": {
          "type": "string",
          "format": "uuid",
          "decorators": ["@manyToOne(Post)"]
        },
        "authorId": {
          "type": "string",
          "format": "uuid",
          "decorators": ["@manyToOne(User)"]
        },
        "parentId": {
          "type": "string",
          "format": "uuid",
          "optional": true,
          "description": "Parent comment ID for nested replies"
        },
        "createdAt": {
          "type": "utcDateTime",
          "decorators": ["@createdAt"]
        }
      }
    },
    "Tag": {
      "description": "A tag for categorizing posts",
      "decorators": ["@table"],
      "fields": {
        "id": {
          "type": "string",
          "format": "uuid",
          "decorators": ["@id"]
        },
        "name": {
          "type": "string",
          "constraints": {
            "minLength": 1,
            "maxLength": 50
          }
        },
        "slug": {
          "type": "string",
          "constraints": {
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    }
  },
  "unions": {
    "UserRole": {
      "description": "User permission levels",
      "variants": ["admin", "author", "reader"]
    },
    "PostStatus": {
      "description": "Publication status of a post",
      "variants": ["draft", "published", "archived"]
    }
  },
  "raw": "@route(\"/api\")\n@tag(\"Blog API\")\nnamespace BlogApiRoutes {\n  @route(\"/posts\")\n  interface Posts {\n    @get list(@query status?: PostStatus): Post[];\n    @get read(@path slug: string): Post;\n    @post create(@body post: Post): Post;\n    @put update(@path id: string, @body post: Post): Post;\n    @delete remove(@path id: string): void;\n  }\n\n  @route(\"/users\")\n  interface Users {\n    @get list(): User[];\n    @get read(@path id: string): User;\n    @post create(@body user: User): User;\n  }\n\n  @route(\"/posts/{postId}/comments\")\n  interface Comments {\n    @get list(@path postId: string): Comment[];\n    @post create(@path postId: string, @body comment: Comment): Comment;\n  }\n}"
}
