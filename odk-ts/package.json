{
  "name": "@omnidotdev/odk",
  "version": "0.1.0",
  "description": "Define schemas with Zod/ArkType/Valibot, emit to OpenAPI/Protobuf/etc via TypeSpec",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "odk": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "arktype": "^2.1.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@typespec/compiler": "^1.0.0",
    "@typespec/json-schema": "^1.0.0",
    "@typespec/openapi3": "^1.0.0",
    "@valibot/to-json-schema": "^1.0.0",
    "arktype": "^2.1.0",
    "valibot": "^1.0.0",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "arktype": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "@valibot/to-json-schema": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT"
}
